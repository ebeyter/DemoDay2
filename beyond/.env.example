# Beyond — yerel ortam değişkenleri
#
# Bu bir ŞABLONDUR ve depoya girer — içine gerçek anahtar YAZMA.
# Kopyala: cp .env.example .env.local — sonra .env.local içini doldur.

# --- Supabase (hesap + profil kalıcılığı) ----------------------------------
# supabase.com → projen → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Bedrock ("Sor AI'a" paneli) -------------------------------------------
# Boş bırakılırsa sadece sohbet paneli "demo modu"na düşer; uygulamanın
# geri kalanı (eşleştirme, kaynak takibi, takvim) etkilenmez.
BEDROCK_URL=
BEDROCK_API_KEY=


# Varsayılan model: google.gemma-4-31b
# Başka bir modele geçmek istersen aşağıdaki satırı aç:
# BEDROCK_MODEL_ID=

# --- Otomatik kaynak taraması (sadece deploy için gerekli) ------------------
# Yerelde `npm run check-sources` kullanılıyor, bu ikisi boş kalabilir.
#
# supabase.com → Settings → API → service_role key
# DİKKAT: NEXT_PUBLIC_ öneki YOK — tarayıcıya sızmıyor, sadece sunucuda okunuyor.
SUPABASE_SERVICE_ROLE_KEY=

# Tarama uç noktasını korur. Rastgele uzun bir dize üret:
#   openssl rand -hex 32
CRON_SECRET=
