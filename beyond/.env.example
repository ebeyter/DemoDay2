# Beyond — yerel ortam değişkenleri
#
# Bu bir ŞABLONDUR ve depoya girer — içine gerçek anahtar YAZMA.
# Kopyala: cp .env.example .env.local — sonra .env.local içini doldur.

# --- Supabase (hesap + profil kalıcılığı) ----------------------------------
# supabase.com → projen → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Bedrock ("Sor AI'a" paneli) -------------------------------------------
# Boş bırakılırsa sadece sohbet paneli "demo modu"na düşer; uygulamanın
# geri kalanı (eşleştirme, kaynak takibi, takvim) etkilenmez.
BEDROCK_URL=https://bedrock-runtime.us-east-1.amazonaws.com
BEDROCK_API_KEY=

# Model, adresteki bölgeye göre otomatik seçiliyor. Hesabında farklı bir
# modele erişimin varsa aşağıdaki satırın başındaki # işaretini kaldır:
# BEDROCK_MODEL_ID=
